{
  "title": "Verana Agent Studio — Overview",
  "uid": "vas-overview",
  "schemaVersion": 39,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Agents Running",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "datasource": "Prometheus", "expr": "vas_agents_running", "legendFormat": "Running" }],
      "options": { "colorMode": "background", "thresholds": { "steps": [{ "color": "green", "value": 0 }] } }
    },
    {
      "id": 2,
      "title": "Agents Down",
      "type": "stat",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "datasource": "Prometheus", "expr": "vas_agents_stopped", "legendFormat": "Down" }],
      "options": { "colorMode": "background", "thresholds": { "steps": [{ "color": "green", "value": 0 }, { "color": "red", "value": 1 }] } }
    },
    {
      "id": 3,
      "title": "Conversations / 5m",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [{ "datasource": "Prometheus", "expr": "rate(vas_conversations_total[5m])", "legendFormat": "{{agentName}}" }]
    },
    {
      "id": 4,
      "title": "Tokens Used / 5m",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [{ "datasource": "Prometheus", "expr": "rate(vas_tokens_used_total[5m])", "legendFormat": "{{agentName}} ({{provider}})" }]
    },
    {
      "id": 5,
      "title": "Response Latency p95",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [{ "datasource": "Prometheus", "expr": "histogram_quantile(0.95, rate(vas_response_latency_seconds_bucket[5m]))", "legendFormat": "{{agentId}} p95" }]
    },
    {
      "id": 6,
      "title": "Errors / 5m",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [{ "datasource": "Prometheus", "expr": "rate(vas_errors_total[5m])", "legendFormat": "{{agentId}} - {{type}}" }]
    },
    {
      "id": 7,
      "title": "MCP Tool Calls / 5m",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "targets": [{ "datasource": "Prometheus", "expr": "rate(vas_mcp_tool_calls_total[5m])", "legendFormat": "{{toolName}} ({{status}})" }]
    },
    {
      "id": 8,
      "title": "Logs",
      "type": "logs",
      "gridPos": { "x": 0, "y": 28, "w": 24, "h": 10 },
      "targets": [{ "datasource": "Loki", "expr": "{job=\"docker\"}" }]
    }
  ]
}
